---
whiskers:
  version: ^2.5.1
  matrix:
    - flavor
  filename: "colors/catppuccin-{{ flavor.identifier }}.lua"
---
-- Catppuccin {{ flavor.name }} for Kugutsu
-- Generated by whiskers from kugutsu.tera. Do not edit this file directly.
return {
  terminal = {
    foreground = "#{{ text.hex }}",
    background = "#{{ base.hex }}",
    cursor = "#{{ rosewater.hex }}",
    ansi = {
{%- if flavor.dark %}
      "#{{ surface1.hex }}", "#{{ red.hex }}", "#{{ green.hex }}", "#{{ yellow.hex }}", "#{{ blue.hex }}", "#{{ pink.hex }}", "#{{ teal.hex }}", "#{{ subtext1.hex }}",
      "#{{ surface2.hex }}", "#{{ red.hex }}", "#{{ green.hex }}", "#{{ yellow.hex }}", "#{{ blue.hex }}", "#{{ pink.hex }}", "#{{ teal.hex }}", "#{{ subtext0.hex }}",
{%- else %}
      "#{{ subtext1.hex }}", "#{{ red.hex }}", "#{{ green.hex }}", "#{{ yellow.hex }}", "#{{ blue.hex }}", "#{{ pink.hex }}", "#{{ teal.hex }}", "#{{ surface2.hex }}",
      "#{{ subtext0.hex }}", "#{{ red.hex }}", "#{{ green.hex }}", "#{{ yellow.hex }}", "#{{ blue.hex }}", "#{{ pink.hex }}", "#{{ teal.hex }}", "#{{ surface1.hex }}",
{%- endif %}
    },
  },
  ui = {
    bar_background = "#{{ mantle.hex }}",
    bar_border = "#{{ surface0.hex }}",
    inactive_foreground = "#{{ overlay1.hex }}",
    active_pane_border = "#{{ lavender.hex }}",
    prefix_indicator = "#{{ peach.hex }}",
    agent_working = "#{{ blue.hex }}",
    agent_blocked = "#{{ yellow.hex }}",
    agent_done = "#{{ green.hex }}",
    error = "#{{ red.hex }}",
    foreground = "#{{ text.hex }}",
    accent = "#{{ lavender.hex }}",
    raised_background = "#{{ surface0.hex }}",
    overlay_background = "#{{ surface0.hex }}",
    strong_border = "#{{ surface1.hex }}",
  },
}
